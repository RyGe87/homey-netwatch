{
  "id": "dev.rymenants.netwatch",
  "version": "0.5.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Network Watch",
    "nl": "Netwerkwacht"
  },
  "description": {
    "en": "Watches your internet connection and reports outages, with how long they lasted",
    "nl": "Bewaakt je internetverbinding en meldt storingen, inclusief hoe lang ze duurden"
  },
  "category": [
    "tools"
  ],
  "brandColor": "#1f6f8b",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Geert Rymenants",
    "email": "geert@rymenants.dev"
  },
  "capabilities": {
    "alarm_internet": {
      "type": "boolean",
      "title": {
        "en": "Internet down",
        "nl": "Internet weg"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "measure_latency": {
      "type": "number",
      "title": {
        "en": "Latency",
        "nl": "Reactietijd"
      },
      "units": {
        "en": "ms"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "alarm_wan": {
      "type": "boolean",
      "title": {
        "en": "WAN down",
        "nl": "WAN weg"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "measure_speed_down": {
      "type": "number",
      "title": {
        "en": "Download speed",
        "nl": "Downloadsnelheid"
      },
      "units": {
        "en": "Mbps"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "measure_speed_up": {
      "type": "number",
      "title": {
        "en": "Upload speed",
        "nl": "Uploadsnelheid"
      },
      "units": {
        "en": "Mbps"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "measure_clients": {
      "type": "number",
      "title": {
        "en": "Connected devices",
        "nl": "Aangesloten apparaten"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "measure_outages_7d": {
      "type": "number",
      "title": {
        "en": "Outages (7 days)",
        "nl": "Storingen (7 dagen)"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "is_home": {
      "type": "boolean",
      "title": {
        "en": "Home",
        "nl": "Thuis"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "internet_lost",
        "title": {
          "en": "The internet connection dropped",
          "nl": "De internetverbinding is weggevallen"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=internet"
          }
        ],
        "tokens": [
          {
            "name": "diagnosis",
            "type": "string",
            "title": {
              "en": "What the gateway saw",
              "nl": "Wat de gateway zag"
            }
          },
          {
            "name": "isp",
            "type": "string",
            "title": {
              "en": "Provider",
              "nl": "Provider"
            }
          }
        ]
      },
      {
        "id": "internet_restored",
        "title": {
          "en": "The internet connection came back",
          "nl": "De internetverbinding is terug"
        },
        "tokens": [
          {
            "name": "minutes",
            "type": "number",
            "title": {
              "en": "Minutes down",
              "nl": "Minuten weg"
            }
          },
          {
            "name": "human",
            "type": "string",
            "title": {
              "en": "Duration",
              "nl": "Duur"
            }
          },
          {
            "name": "diagnosis",
            "type": "string",
            "title": {
              "en": "What the gateway saw",
              "nl": "Wat de gateway zag"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=internet"
          }
        ]
      },
      {
        "id": "wan_down",
        "title": {
          "en": "The gateway lost its WAN connection",
          "nl": "De gateway verloor de WAN-verbinding"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gateway"
          }
        ]
      },
      {
        "id": "wan_up",
        "title": {
          "en": "The gateway regained its WAN connection",
          "nl": "De gateway heeft de WAN-verbinding terug"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gateway"
          }
        ]
      },
      {
        "id": "public_ip_changed",
        "title": {
          "en": "The public IP address changed",
          "nl": "Het publieke IP-adres is veranderd"
        },
        "tokens": [
          {
            "name": "ip",
            "type": "string",
            "title": {
              "en": "New IP",
              "nl": "Nieuw IP"
            }
          },
          {
            "name": "previous",
            "type": "string",
            "title": {
              "en": "Previous IP",
              "nl": "Vorig IP"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gateway"
          }
        ]
      },
      {
        "id": "speedtest_updated",
        "title": {
          "en": "A new speed test result arrived",
          "nl": "Er is een nieuw snelheidstestresultaat"
        },
        "tokens": [
          {
            "name": "down",
            "type": "number",
            "title": {
              "en": "Download (Mbps)",
              "nl": "Download (Mbps)"
            }
          },
          {
            "name": "up",
            "type": "number",
            "title": {
              "en": "Upload (Mbps)",
              "nl": "Upload (Mbps)"
            }
          },
          {
            "name": "ping",
            "type": "number",
            "title": {
              "en": "Ping (ms)",
              "nl": "Ping (ms)"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gateway"
          }
        ]
      },
      {
        "id": "came_home",
        "title": {
          "en": "Arrived home",
          "nl": "Is thuisgekomen"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=presence"
          }
        ]
      },
      {
        "id": "left_home",
        "title": {
          "en": "Left home",
          "nl": "Is vertrokken"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=presence"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "internet_available",
        "title": {
          "en": "The internet !{{is|is not}} available",
          "nl": "Het internet !{{is|is niet}} beschikbaar"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=internet"
          }
        ]
      },
      {
        "id": "is_home",
        "title": {
          "en": "!{{Is|Is not}} home",
          "nl": "!{{Is|Is niet}} thuis"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=presence"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "internet",
      "name": {
        "en": "Internet connection",
        "nl": "Internetverbinding"
      },
      "class": "sensor",
      "capabilities": [
        "alarm_internet",
        "measure_latency",
        "measure_outages_7d"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/internet/assets/images/small.png",
        "large": "/drivers/internet/assets/images/large.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "gateway",
      "name": {
        "en": "UniFi gateway",
        "nl": "UniFi-gateway"
      },
      "class": "sensor",
      "capabilities": [
        "alarm_wan",
        "measure_latency",
        "measure_speed_down",
        "measure_speed_up",
        "measure_clients"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/gateway/assets/images/small.png",
        "large": "/drivers/gateway/assets/images/large.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "isp",
          "type": "label",
          "value": "-",
          "label": {
            "en": "Internet provider",
            "nl": "Internetprovider"
          }
        },
        {
          "id": "public_ip",
          "type": "label",
          "value": "-",
          "label": {
            "en": "Public IP address",
            "nl": "Publiek IP-adres"
          }
        }
      ]
    },
    {
      "id": "presence",
      "name": {
        "en": "Network presence",
        "nl": "Netwerkaanwezigheid"
      },
      "class": "sensor",
      "capabilities": [
        "is_home"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/presence/assets/images/small.png",
        "large": "/drivers/presence/assets/images/large.png"
      },
      "settings": [
        {
          "id": "away_minutes",
          "type": "number",
          "value": 10,
          "min": 1,
          "max": 120,
          "label": {
            "en": "Away after (minutes)",
            "nl": "Weg na (minuten)"
          },
          "hint": {
            "en": "How long the device must be gone before it counts as away. Phones drop off wifi briefly all the time; a few minutes of patience prevents flapping.",
            "nl": "Hoe lang het apparaat weg moet zijn voor het als vertrokken telt. Telefoons vallen voortdurend even van wifi; wat geduld voorkomt geflikker."
          }
        }
      ],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    }
  ],
  "api": {
    "test": {
      "method": "GET",
      "path": "/test"
    },
    "outages": {
      "method": "GET",
      "path": "/outages"
    }
  }
}